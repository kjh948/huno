<?xml version="1.0"?>
<robot name="robobuilder_huno">

  <!-- ================= MATERIALS ================= -->
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.2 0.2 0.8 1.0"/>
  </material>

  <!-- ================= BASE ================= -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.16 0.12 0.06"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.16 0.12 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ================================================= -->
  <!-- ================= LEFT LEG ====================== -->
  <!-- ================================================= -->

  <!-- Hip Yaw -->
  <link name="l_hip_yaw_link"/>
  <joint name="l_hip_yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="l_hip_yaw_link"/>
    <origin xyz="0 0.05 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="5" velocity="5"/>
  </joint>

  <!-- Hip Roll -->
  <link name="l_hip_roll_link"/>
  <joint name="l_hip_roll_joint" type="revolute">
    <parent link="l_hip_yaw_link"/>
    <child link="l_hip_roll_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="5"/>
  </joint>

  <!-- Thigh -->
  <link name="l_thigh_link">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.10"/>
      </geometry>
      <origin xyz="0 0 -0.05"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="0.10"/>
      </geometry>
      <origin xyz="0 0 -0.05"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 -0.05"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="l_hip_pitch_joint" type="revolute">
    <parent link="l_hip_roll_link"/>
    <child link="l_thigh_link"/>
    <origin xyz="0 0 -0.02"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="5"/>
  </joint>

  <!-- Shin -->
  <link name="l_shin_link">
    <visual>
      <geometry>
        <cylinder radius="0.018" length="0.10"/>
      </geometry>
      <origin xyz="0 0 -0.05"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.018" length="0.10"/>
      </geometry>
      <origin xyz="0 0 -0.05"/>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <origin xyz="0 0 -0.05"/>
      <inertia ixx="0.0008" iyy="0.0008" izz="0.0008"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="l_knee_pitch_joint" type="revolute">
    <parent link="l_thigh_link"/>
    <child link="l_shin_link"/>
    <origin xyz="0 0 -0.10"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.4" effort="5" velocity="5"/>
  </joint>

  <!-- Foot -->
  <link name="l_foot_link">
    <visual>
      <geometry>
        <box size="0.08 0.04 0.015"/>
      </geometry>
      <origin xyz="0.02 0 -0.01"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.08 0.04 0.015"/>
      </geometry>
      <origin xyz="0.02 0 -0.01"/>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0.02 0 -0.01"/>
      <inertia ixx="0.0003" iyy="0.0003" izz="0.0003"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="l_ankle_pitch_joint" type="revolute">
    <parent link="l_shin_link"/>
    <child link="l_foot_link"/>
    <origin xyz="0 0 -0.10"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="5" velocity="5"/>
  </joint>

  <!-- ================================================= -->
  <!-- ================= RIGHT LEG ===================== -->
  <!-- ================================================= -->

  <link name="r_hip_yaw_link"/>
  <joint name="r_hip_yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="r_hip_yaw_link"/>
    <origin xyz="0 -0.05 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="5" velocity="5"/>
  </joint>

  <link name="r_hip_roll_link"/>
  <joint name="r_hip_roll_joint" type="revolute">
    <parent link="r_hip_yaw_link"/>
    <child link="r_hip_roll_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="5"/>
  </joint>

  <link name="r_thigh_link">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.10"/>
      </geometry>
      <origin xyz="0 0 -0.05"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="0.10"/>
      </geometry>
      <origin xyz="0 0 -0.05"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 -0.05"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="r_hip_pitch_joint" type="revolute">
    <parent link="r_hip_roll_link"/>
    <child link="r_thigh_link"/>
    <origin xyz="0 0 -0.02"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="5"/>
  </joint>

  <link name="r_shin_link">
    <visual>
      <geometry>
        <cylinder radius="0.018" length="0.10"/>
      </geometry>
      <origin xyz="0 0 -0.05"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.018" length="0.10"/>
      </geometry>
      <origin xyz="0 0 -0.05"/>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <origin xyz="0 0 -0.05"/>
      <inertia ixx="0.0008" iyy="0.0008" izz="0.0008"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="r_knee_pitch_joint" type="revolute">
    <parent link="r_thigh_link"/>
    <child link="r_shin_link"/>
    <origin xyz="0 0 -0.10"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.4" effort="5" velocity="5"/>
  </joint>

  <link name="r_foot_link">
    <visual>
      <geometry>
        <box size="0.08 0.04 0.015"/>
      </geometry>
      <origin xyz="0.02 0 -0.01"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.08 0.04 0.015"/>
      </geometry>
      <origin xyz="0.02 0 -0.01"/>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0.02 0 -0.01"/>
      <inertia ixx="0.0003" iyy="0.0003" izz="0.0003"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="r_ankle_pitch_joint" type="revolute">
    <parent link="r_shin_link"/>
    <child link="r_foot_link"/>
    <origin xyz="0 0 -0.10"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="5" velocity="5"/>
  </joint>

</robot>
