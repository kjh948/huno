  </link>

  <!-- ========== RIGHT LEG (IDs: 00, 01, 02, 03) ========== -->
  <!-- Joint 00: Right Hip Pitch -->
  <joint name="r_hip_pitch" type="revolute">
    <parent link="base_link"/>
    <child link="r_hip_pitch_link"/>
    <origin xyz="0.025 -0.01 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="2.0" velocity="5.0"/>
  </joint>

  <link name="r_hip_pitch_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="huno_meshes/hip_joint.stl"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="huno_meshes/hip_joint.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- Joint 01: Right Hip Roll -->
  <joint name="r_hip_roll" type="revolute">
    <parent link="r_hip_pitch_link"/>
    <child link="r_thigh_link"/>
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.8" upper="0.8" effort="2.0" velocity="5.0"/>
  </joint>

  <link name="r_thigh_link">
    <visual>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <geometry>
        <mesh filename="huno_meshes/thigh.stl"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <geometry>
        <mesh filename="huno_meshes/thigh.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.00007" ixy="0" ixz="0" iyy="0.00007" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- Joint 02: Right Knee -->
  <joint name="r_knee" type="revolute">
    <parent link="r_thigh_link"/>
    <child link="r_shin_link"/>
    <origin xyz="0 0 -0.07" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.1" upper="2.0" effort="2.0" velocity="5.0"/>
  </joint>

  <link name="r_shin_link">
    <visual>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <geometry>
        <mesh filename="huno_meshes/shin.stl"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <geometry>
        <mesh filename="huno_meshes/shin.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.12"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00001"/>
