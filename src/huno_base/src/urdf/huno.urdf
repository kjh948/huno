  </link>

  <!-- Joint 03: Right Ankle -->
  <joint name="r_ankle" type="revolute">
    <parent link="r_shin_link"/>
    <child link="r_foot_link"/>
    <origin xyz="0 0 -0.07" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="1.5" velocity="5.0"/>
  </joint>

  <link name="r_foot_link">
    <visual>
      <origin xyz="0 0.01 -0.0075" rpy="0 0 0"/>
      <geometry>
        <mesh filename="huno_meshes/foot.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0.01 -0.0075" rpy="0 0 0"/>
      <geometry>
        <mesh filename="huno_meshes/foot.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- ========== LEFT LEG (IDs: 05, 06, 07, 08) ========== -->
  <!-- Joint 05: Left Hip Pitch -->
  <joint name="l_hip_pitch" type="revolute">
    <parent link="base_link"/>
    <child link="l_hip_pitch_link"/>
    <origin xyz="-0.025 -0.01 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="2.0" velocity="5.0"/>
  </joint>

  <link name="l_hip_pitch_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="huno_meshes/hip_joint.stl"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="huno_meshes/hip_joint.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- Joint 06: Left Hip Roll -->
  <joint name="l_hip_roll" type="revolute">
    <parent link="l_hip_pitch_link"/>
    <child link="l_thigh_link"/>
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.8" upper="0.8" effort="2.0" velocity="5.0"/>
  </joint>

  <link name="l_thigh_link">
    <visual>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <geometry>
        <mesh filename="huno_meshes/thigh.stl"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <geometry>
        <mesh filename="huno_meshes/thigh.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.00007" ixy="0" ixz="0" iyy="0.00007" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- Joint 07: Left Knee -->
  <joint name="l_knee" type="revolute">
