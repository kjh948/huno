  </link>

  <!-- ========== WAIST/TAIL (ID: 15) ========== -->
  <!-- Joint 15: Waist/Tail -->
  <joint name="waist_joint" type="revolute">
    <parent link="base_link"/>
    <child link="waist_link"/>
    <origin xyz="0 -0.035 -0.02" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.5" effort="1.0" velocity="5.0"/>
