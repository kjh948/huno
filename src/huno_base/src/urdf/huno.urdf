    <origin xyz="0 0 -0.07" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.1" upper="2.0" effort="2.0" velocity="5.0"/>
  </joint>

  <link name="l_shin_link">
    <visual>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <geometry>
        <mesh filename="huno_meshes/shin.stl"/>
